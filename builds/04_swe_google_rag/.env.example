# Required credential. Keep the real value in an untracked .env file.
GOOGLE_API_KEY=

# Select and verify exact model IDs before implementation.
GENERATION_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=

# Paths are resolved relative to this project directory.
